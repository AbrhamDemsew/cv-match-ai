# Gemini API key from Google AI Studio. Never set this in a VITE_ variable.
GEMINI_API_KEY=<SECRET>

# Gemini model ID. Example: gemini-2.0-flash
# Verify model availability in your AI Studio project before deployment.
GEMINI_MODEL=gemini-2.0-flash

# Appwrite server API key with minimal scopes (databases.write, storage.read).
# Never expose this key in browser code or git history.
APPWRITE_API_KEY=<SECRET>

# These two are injected automatically by the Appwrite runtime.
# Set them manually only for local testing.
APPWRITE_FUNCTION_API_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_FUNCTION_PROJECT_ID=<PROJECT_ID>

# Appwrite resource IDs. Must match your Console configuration.
APPWRITE_DATABASE_ID=cvmatch
APPWRITE_RESUMES_BUCKET_ID=resumes
