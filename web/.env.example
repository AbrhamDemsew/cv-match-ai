# ---------------------------------------------------------------------------
# CVMatch AI — public frontend configuration
# ---------------------------------------------------------------------------
# Copy this file to web/.env.local and fill in the values from Appwrite Console.
#
# IMPORTANT: Vite embeds every VITE_* variable into the browser bundle. Only
# public identifiers belong here. Never add GEMINI_API_KEY, an Appwrite server
# API key, or any other secret to this file.
#
# After changing values, restart `npm run dev` or rebuild the app.
# ---------------------------------------------------------------------------

# Required in Phase 1. Example: https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=<APPWRITE_PROJECT_ID>

# Optional in Phase 1. Required when the corresponding later phase is built.
VITE_APPWRITE_DATABASE_ID=<DATABASE_ID>
VITE_APPWRITE_RESUMES_BUCKET_ID=<RESUMES_BUCKET_ID>
VITE_APPWRITE_REPORTS_BUCKET_ID=<REPORTS_BUCKET_ID>
VITE_APPWRITE_ANALYZE_FUNCTION_ID=<ANALYZE_FUNCTION_ID>
