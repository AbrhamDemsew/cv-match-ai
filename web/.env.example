# ---------------------------------------------------------------------------
# CVMatch AI — public frontend configuration
# ---------------------------------------------------------------------------
# Copy this file to web/.env.local and fill in the values from Appwrite Console.
# Values are intentionally blank so a copied file cannot accidentally point at
# an incomplete Appwrite project.
#
# IMPORTANT: Vite embeds every VITE_* variable into the browser bundle. Only
# public identifiers belong here. Never add GEMINI_API_KEY, an Appwrite server
# API key, or any other secret to this file.
#
# After changing values, restart `npm run dev` or rebuild the app.
# ---------------------------------------------------------------------------

# Required for the app and authentication.
# Example endpoint: https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=

# Required for Phase 3 profiles, CV metadata, jobs, and private CV files.
# Examples: database ID "cvmatch", bucket ID "resumes".
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_RESUMES_BUCKET_ID=

# Optional until the analysis and report phases are implemented.
VITE_APPWRITE_REPORTS_BUCKET_ID=
VITE_APPWRITE_ANALYZE_FUNCTION_ID=
